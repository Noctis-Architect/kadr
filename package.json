{
  "name": "kadr",
  "version": "0.2.0",
  "description": "Local, minimal video editor that coding agents (Claude Code, Codex, Aider, ...) can drive through plain files. HTML/CSS/JS motion graphics, ffmpeg export.",
  "type": "module",
  "bin": {
    "kadr": "bin/kadr.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "bin",
    "src",
    "shared",
    "runtime",
    "builtin",
    "template",
    "skills",
    "web"
  ],
  "scripts": {
    "start": "node bin/kadr.js serve",
    "desktop:node": "node scripts/fetch-node.mjs",
    "desktop:dev": "node scripts/fetch-node.mjs && tauri dev",
    "desktop:build": "node scripts/fetch-node.mjs && tauri build"
  },
  "license": "MIT",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.5"
  }
}
